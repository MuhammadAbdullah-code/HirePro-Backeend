APP_NAME="HirePro API"
APP_VERSION="0.1.0"
API_PREFIX="/api/v1"
DOCS_ENABLED=true
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'
CORS_ORIGIN_REGEX='^https?://(?:localhost|127\.0\.0\.1)(?::\d+)?$'
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="HirePro"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
ACCESS_TOKEN_MINUTES=1440
ADMIN_EMAIL="admin@hirepro.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
PAYMENT_WEBHOOK_SECRET="replace-with-payment-provider-webhook-secret"
UPLOAD_DIRECTORY="uploads"
MAXIMUM_UPLOAD_BYTES=5242880
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="hirepro"
